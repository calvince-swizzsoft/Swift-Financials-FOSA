
<!DOCTYPE html>

<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <title>Employee Account Created</title>
</head>
<body>
    <p>
        Dear @Raw(Model.FirstName),
    </p>
    <p>
        Your employee account with @Raw(Model.CompanyDescription) has been created successfully.
    </p>
    <p>
        This is an automatically generated email, please do not reply to this address.
    </p>
    <p>
        @Raw(Model.CompanyDescription)
    </p>
</body>
</html>
